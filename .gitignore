# ── OS / editors ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# ── Local-only project notes (never publish to the public repo) ─
# CLAUDE.md + docs/ are internal working notes; keep them out of the
# published tree. Public docs live in README.md.
/CLAUDE.md
/docs/
.claude/

# ── Toolchains / SDKs (installed outside the repo) ──────────────
/d/sdk/
*.zip.download

# ── Python (collector) ─────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/
collector/.cache/
collector/out/
collector/state/*.json

# ── Node / Cloudflare (backend) ────────────────────────────────
node_modules/
.wrangler/
backend/dist/
*.log
.dev.vars
.env
.env.*
!.env.example

# ── Flutter / Dart (app) ───────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.pub-cache/
# pubspec.lock IS committed for the app (reproducible builds)
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/**/GeneratedPluginRegistrant.*
app/ios/Pods/
app/linux/flutter/ephemeral/
app/windows/flutter/ephemeral/
*.g.dart
*.freezed.dart

# ── Native core (Go FFI) ───────────────────────────────────────
native/**/out/
native/**/*.so
native/**/*.dll
native/**/*.dylib
native/**/*.a
native/**/*.h.bak

# Local diagnostic harness + scraped keys used to reproduce net bugs —
# never commit third-party keys. The harness self-skips without WRN_PROBE=1.
native/weronity_core/_probe/
native/weronity_core/zz_probe_test.go

# ── Generated / downloaded data ────────────────────────────────
*.mmdb
collector/geoip/*
!collector/geoip/README.md
secrets.local.*

# sing-box runtime cache (should never be created now, but just in case)
cache.db
*.db
